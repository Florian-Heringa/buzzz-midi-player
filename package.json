{
  "name": "electron-midi-player",
  "version": "0.1.0",
  "description": "Electron MIDI player for practicing vocal parts",
  "main": "./out/main/index.js",
  "author": "Florian Heringa",
  "homepage": "https://github.com/Florian-Heringa/electron-midi-player",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint .",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "fetch-soundfont": "node scripts/fetch-soundfont.mjs",
    "make-samples": "node scripts/make-samples.mjs",
    "smoke": "electron-vite build && node scripts/drive.mjs",
    "build:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "js-synthesizer": "^1.13.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "midi-file": "^1.2.4",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vexflow": "^5.0.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
